  // เริ่มเขียนโค้ดตรงนี้
function calculateShippingCost(order) {
    if(order.total >= 5000) {
        return  "Shipping is free.";
    } else if(order.total >= 2000) {
        return  "Shipping cost is 250 Baht.";
    } else {
        return  "Shipping cost is 500 Baht.";
    }
}

